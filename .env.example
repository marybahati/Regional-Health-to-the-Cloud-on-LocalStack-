# Copy to .env and `source` it. Never commit this file.
LOCALSTACK_AUTH_TOKEN=
# Leave token empty for community mode (Secrets Manager + docker app).
# Hobby token enables Docker-backed EC2 + ELBv2 (ACTIVATE_PRO=1).
ACTIVATE_PRO=0
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Path-style S3 so Terraform state works on community LocalStack (no s3.localhost.localstack.cloud DNS).
S3_HOSTNAME=localhost
EC2_DOCKER_FLAGS=--memory=512m

# Aiven MySQL (free). See docs/aiven-mysql.md
AIVEN_MYSQL_HOST=
AIVEN_MYSQL_PORT=
AIVEN_MYSQL_USER=avnadmin
AIVEN_MYSQL_PASSWORD=
AIVEN_MYSQL_DB=defaultdb
AIVEN_CA_PATH=./ca.pem
